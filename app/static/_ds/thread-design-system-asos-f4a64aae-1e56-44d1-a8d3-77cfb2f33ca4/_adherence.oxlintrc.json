        "selector": "JSXOpeningElement[name.name='Checkbox'] > JSXAttribute[name.name='shape'] > Literal[value!=/^(?:Square|Rounded)$/]",
        "message": "<Checkbox> shape must be one of 'Square' | 'Rounded'."
