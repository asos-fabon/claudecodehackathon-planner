{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/commerce/**",
              "components/feedback/**",
              "components/forms/**",
              "components/layout/**",
              "components/media/**",
              "components/navigation/**",
              "components/overlay/**",
              "ui_kits/asos-account/**",
              "ui_kits/asos-returns/**",
              "ui_kits/asos-web/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Futura PT))/i]",
        "message": "Font not provided by the design system. Available: Futura PT."
      },
      {
        "selector": "JSXOpeningElement[name.name='AccordionItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|content|key|ref|className|style|children)$/]",
        "message": "<AccordionItem> doesn't accept that prop. Declared props: title, content."
      },
      {
        "selector": "JSXOpeningElement[name.name='ActionBarItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|label|active|onClick|key|ref|className|style|children)$/]",
        "message": "<ActionBarItem> doesn't accept that prop. Declared props: icon, label, active, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='Alert'] > JSXAttribute > JSXIdentifier[name!=/^(?:type|title|children|onClose|key|ref|className|style|children)$/]",
        "message": "<Alert> doesn't accept that prop. Declared props: type, title, children, onClose."
      },
      {
        "selector": "JSXOpeningElement[name.name='Alert'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:Information|Success|Warning|Error|System)$/]",
        "message": "<Alert> type must be one of 'Information' | 'Success' | 'Warning' | 'Error' | 'System'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BagItemCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:brand|name|price|wasPrice|size|colour|qty|tint|image|onQtyChange|onRemove|readOnly|key|ref|className|style|children)$/]",
        "message": "<BagItemCard> doesn't accept that prop. Declared props: brand, name, price, wasPrice, size, colour, qty, tint, image, onQtyChange, onRemove, readOnly."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:type|size|pill|fullWidth|disabled|startIcon|endIcon|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: type, size, pill, fullWidth, disabled, startIcon, endIcon, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:small|default|large)$/]",
        "message": "<Button> size must be one of 'small' | 'default' | 'large'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checkbox'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|checked|shape|disabled|style|key|ref|className|style|children)$/]",
        "message": "<Checkbox> doesn't accept that prop. Declared props: label, checked, shape, disabled, style."
      },
